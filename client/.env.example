# KisanDirect — Frontend Environment Variables
# Copy this file to .env and fill in values.
# DO NOT add any secret keys here — this is bundled into the browser.

# Local development
VITE_API_URL=http://localhost:5000/api

# Production (set this in Vercel dashboard → Environment Variables)
# VITE_API_URL=https://your-backend.onrender.com/api
