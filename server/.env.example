# KisanDirect — Server Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to git.

PORT=5000
CLIENT_URL=http://localhost:3000
JWT_SECRET=replace_with_a_long_random_secret_string
JWT_EXPIRES_IN=7d
NODE_ENV=development

# ── Resend Email Service ────────────────────────────────────────────────────
# Get your key from https://resend.com/api-keys
RESEND_API_KEY=re_your_api_key_here

# Sender address.
# FREE TIER: use onboarding@resend.dev — but Resend only delivers to RESEND_OWNER_EMAIL
# PAID / DOMAIN VERIFIED: use noreply@yourdomain.com
EMAIL_FROM=onboarding@resend.dev

# Your verified Resend account email.
# Free-tier: ALL emails are redirected here regardless of the farmer's address.
RESEND_OWNER_EMAIL=your-resend-account@gmail.com

# Set to "true" ONLY after you have verified a sending domain at resend.com/domains
# and updated EMAIL_FROM to use that domain.
# When "false": OTP/welcome emails are redirected to RESEND_OWNER_EMAIL.
EMAIL_DOMAIN_VERIFIED=false
